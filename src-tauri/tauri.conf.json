{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BRGY",
  "version": "0.1.0",
  "identifier": "com.brgy.payatas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Barangay Payatas",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1N0I5RDI2N0RENDU3OEYKUldTUFY5UjlKcDE3aFVObTFQSzdRdVluZ2dPeEs0L3R6L1FKVWlDenlHZHEwL1YrVEVsWHV1cCsK",
      "endpoints": [
        "https://github.com/sainttlaurel/BRGYORG_PH/releases/latest/download/latest.json"
      ]
    }
  }
}
